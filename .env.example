# ========================================================
# Paystack Multi-Site Webhook & Callback Proxy Environment
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Paystack API & Webhook Configuration
# Secret key from your Paystack Dashboard (sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret (defaults to PAYSTACK_SECRET_KEY if omitted)
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IP Whitelisting (Toggleable)
# When enabled, only requests from Paystack's official IP ranges are accepted
ENABLE_IP_WHITELIST=false
# Comma-separated list of allowed IPs
PAYSTACK_IP_WHITELIST=52.31.139.228,52.214.14.220,54.76.137.41

# Proxy Authentication & Downstream Security
# Shared secret used to sign downstream requests via x-proxy-signature header
PROXY_SHARED_SECRET=your-secure-internal-shared-secret-key-min-32-chars

# Forwarding & Retry Configuration
# Timeout for forwarding HTTP requests to child sites (in milliseconds)
FORWARD_TIMEOUT_MS=8000
# Comma-separated retry delays in milliseconds: +15s, +1m, +5m, +15m
RETRY_DELAYS_MS=15000,60000,300000,900000
# Maximum number of retry attempts before dead-lettering and alerting
MAX_RETRIES=4

# Queue & Idempotency Storage
# Storage adapter: 'memory', 'sqlite', or 'redis'
QUEUE_STORAGE_TYPE=memory
# Path to SQLite database file (when QUEUE_STORAGE_TYPE=sqlite)
SQLITE_DB_PATH=./data/proxy.db
# Redis connection URL (when QUEUE_STORAGE_TYPE=redis)
REDIS_URL=redis://127.0.0.1:6379/0
# Idempotency event TTL in seconds (default: 86400 = 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400

# Failure Alerting Hooks (Optional)
# Discord webhook URL for dead-letter & unroutable event alerts
DISCORD_WEBHOOK_URL=
# Telegram Bot alert configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sites Registry Configuration
SITES_CONFIG_PATH=./config/sites.json

# Dashboard Authentication & Security
# Protects /api/v1/dashboard and configuration settings
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=paystack-proxy-admin-2026
DASHBOARD_JWT_SECRET=tsk-proxy-dashboard-jwt-secret-key-min-32-chars
DASHBOARD_SESSION_HOURS=24
