{
  "name": "paystack-proxy",
  "version": "1.0.0",
  "description": "Multi-site Paystack webhook dispatcher and callback proxy",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build && node scripts/build.js",
    "test": "node --test test/**/*.test.js",
    "test:e2e": "node --test test/e2e.test.js test/live-server.test.js"
  },
  "keywords": [
    "paystack",
    "webhook",
    "proxy",
    "dispatcher",
    "callback",
    "multisite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0"
  }
}
