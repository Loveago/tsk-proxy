{
  "version": 2,
  "installCommand": "npm install && npm --prefix frontend install",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "frontend/out/**",
        "public/**",
        "config/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!_next|favicon.ico|static).*)",
      "destination": "/api/index.js?__path=/:path*"
    }
  ]
}
